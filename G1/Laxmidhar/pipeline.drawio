        <mxCell id="c_trace" value="is_call / is_ret / target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="trace_port" target="shieldv">
          <mxGeometry relative="1" as="geometry" />
