        <mxCell id="c_flush" value="flush" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="flush_unit" target="pipe_ifid">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="490" />
              <mxPoint x="380" y="490" />
