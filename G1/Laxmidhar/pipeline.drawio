        <mxCell id="c_trap" value="sh_trap / freeze" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="shieldv" target="hazard_unit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
