y="165" /></Array></mxGeometry></mxCell><mxCell id="e25" value="alu_op" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.15;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="dec" target="alu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="145" /></Array></mxGeometry></mxCell><mxCell id="e26" value="wb_sel" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.8235;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="dec" target="wb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="105" /><mxPoint x="1200" y="105" /></Array></mxGeometry></mxCell><mxCell id="e27" value="hold, trap" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="sv" target="pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Solid arrows = data (32-bit unless noted). Dashed grey = control from the A3 decoder (or from ShieldV).&lt;br&gt;One instruction per clock: PC → instruction RAM → decoder / register file / immediate → ALU and branch unit → data RAM → WB mux → back into rd.&lt;br&gt;Branch unit also gets funct3 and is_branch / is_jal / is_jalr from A3; jalr target = (rs1 + imm) with bit 0 cleared.&lt;br&gt;Data RAM gets is_load / is_store and funct3 from A3 (sb/sh/sw byte enables, lb/lh/lbu/lhu sign or zero extension).&lt;br&gt;core_single.v reads both RAMs asynchronously and uses regfile WRITE_THROUGH = 0 (simulation only). pc_reg.v (A1) adds hold / trap / redirect for the pipelined core and ShieldV." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1240" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
