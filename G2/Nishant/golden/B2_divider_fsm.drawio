  <diagram id="divider-fsm" name="Divider FSM">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="B2 Restoring Divider — FSM (divider.v)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="25" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="idle" value="IDLE&#xa;state = 2'b00&#xa;busy = 0&#xa;Wait for start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14" vertex="1" parent="1"><mxGeometry x="90" y="250" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="run" value="RUN&#xa;state = 2'b01&#xa;32 restoring iterations&#xa;busy = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14" vertex="1" parent="1"><mxGeometry x="490" y="250" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="fin" value="FIN&#xa;state = 2'b10&#xa;Register result&#xa;Pulse done = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14" vertex="1" parent="1"><mxGeometry x="490" y="500" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="idleLoop" value="start = 0&#xa;remain idle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="idle" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="200"/><mxPoint x="235" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="idleRun" value="start = 1&#xa;ordinary operands&#xa;initialize |a|, |b|, rem=0, count=0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="idle" target="run"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="idleFin" value="start = 1 and&#xa;(b = 0 OR signed INT_MIN / -1)&#xa;save special result; skip RUN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="idle" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="410"/><mxPoint x="590" y="410"/></Array></mxGeometry></mxCell>
        <mxCell id="runLoop" value="count != 31&#xa;shift, subtract/restore, append quotient bit&#xa;count ← count + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="run" target="run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="220"/><mxPoint x="650" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="runFin" value="count = 31&#xa;last iteration is committed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="run" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="finIdle" value="next clock&#xa;state ← IDLE&#xa;busy drops after FIN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12" edge="1" parent="1" source="fin" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="650"/><mxPoint x="180" y="650"/></Array></mxGeometry></mxCell>
        <mxCell id="notes" value="Notes&#xa;• Special cases are processed in FIN without the 32-step loop.&#xa;• Normal path: IDLE → RUN for 32 iterations → FIN.&#xa;• In FIN, result is selected from special_val, signed quotient, or signed remainder.&#xa;• busy = (state != IDLE). done is asserted for one cycle in FIN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="760" y="420" width="350" height="175" as="geometry"/></mxCell>
      </root>
